<IfModule mod_rewrite.c>

    Options -MultiViews
    RewriteEngine On

    # Jika file atau direktori fisik ada, biarkan diakses langsung (seperti CSS, JS, gambar)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Jika tidak, arahkan semua request ke index.php
    RewriteRule ^(.*)$ index.php?path=$1 [QSA,L]

</IfModule>
